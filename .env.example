# ──────────────────────────────────────────────
# Healthcare Knowledge Navigator — Environment
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── LLM Provider ─────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Vector Database ──────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Models ───────────────────────────────────
EMBEDDING_MODEL=MedCPT
RERANKER_MODEL=bge-reranker-large

# ── Collection Settings ─────────────────────
COLLECTION_NAME=medical_documents

# ── Retrieval Parameters ─────────────────────
TOP_K=20
FINAL_K=5

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO

# ── Ingestion Pipeline ──────────────────────
MAX_DOWNLOADS=1000
REQUEST_DELAY=0.3
MAX_RETRIES=3
TIMEOUT=20
NCBI_API_KEY=
NCBI_EMAIL=
