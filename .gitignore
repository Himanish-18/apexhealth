# ──────────────────────────────────────────────
# Healthcare Knowledge Navigator — .gitignore
# ──────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ─────────────────────
venv/
.venv/
env/

# ── Testing ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Environment Variables ────────────────────
.env
.env.example

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Data Directories ─────────────────────────
data/raw_xml/
data/parsed_json/
data/chunks/

# ── Database Files ────────────────────────────
*.db
*.sqlite3

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Docker ────────────────────────────────────
qdrant_storage/

# ── OS Files ──────────────────────────────────
.DS_Store
Thumbs.db

# ── Model Artifacts ──────────────────────────
models/*.bin
models/*.pt
models/*.onnx

# ── Distribution / Build ─────────────────────
dist/
build/
*.egg-info/
